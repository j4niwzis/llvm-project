template <typename T>
constexpr const char *__cppsh_cstr(const T &v) {
  if constexpr (requires { v.c_str(); })
    return v.c_str();
  else if constexpr (requires { v.name.c_str(); })
    return v.name.c_str();
  else
    return static_cast<const char *>(v);
}

template <typename T>
void print(const T &v) {
  if constexpr (requires { v.dump(); })
    v.dump();
  else if constexpr (requires { std::cout << v; })
    std::cout << v << '\n';
}

namespace ranges {
namespace views {

struct __cppsh_grep_pred {
  std::string pat;
  template <typename Item>
  bool operator()(const Item &item) const {
    if constexpr (requires { item.text; })
      return item.text.find(pat) != std::string::npos;
    else if constexpr (requires { item.name; })
      return item.name.find(pat) != std::string::npos;
    else if constexpr (requires { std::string_view(item); })
      return std::string_view(item).find(pat) != std::string_view::npos;
    else if constexpr (requires { item.c_str(); })
      return std::strstr(item.c_str(), pat.c_str()) != nullptr;
    else
      return false;
  }
};

template <typename Pat>
inline auto grep(const Pat &p) {
  return std::ranges::views::filter(
      __cppsh_grep_pred{std::string(__cppsh_cstr(p))});
}

template <typename Proj>
struct __cppsh_sort_stage
    : std::ranges::__range_adaptor_closure<__cppsh_sort_stage<Proj>> {
  Proj proj;
  constexpr explicit __cppsh_sort_stage(Proj p) : proj(std::move(p)) {}

  template <std::ranges::input_range Rng>
  auto operator()(Rng &&rng) const {
    using ElemT = std::ranges::range_value_t<Rng>;
    std::vector<ElemT> out;
    for (auto &&item : rng)
      out.push_back(item);
    std::ranges::sort(out, {}, proj);
    return out;
  }
};

struct __cppsh_sort_by_fn {
  template <std::ranges::input_range Rng, typename Proj>
  auto operator()(Rng &&rng, Proj p) const {
    return __cppsh_sort_stage<std::decay_t<Proj>>(std::move(p))(
        std::forward<Rng>(rng));
  }

  template <typename Proj>
  constexpr auto operator()(Proj p) const {
    return __cppsh_sort_stage<std::decay_t<Proj>>(std::move(p));
  }
};
inline constexpr __cppsh_sort_by_fn sort_by{};

struct __cppsh_show_stage
    : std::ranges::__range_adaptor_closure<__cppsh_show_stage> {
  template <std::ranges::input_range Rng>
  void operator()(Rng &&rng) const {
    for (auto &&item : rng) {
      if constexpr (requires { item.dump(); })
        item.dump();
      else
        std::print(item);
    }
  }
};
inline constexpr __cppsh_show_stage show{};

