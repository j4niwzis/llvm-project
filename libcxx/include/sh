// ---- External commands ---------------------------------------------------
//
// A command is a program and its words (argv), spawned directly -- no
// /bin/sh re-reading them: a word is one argument, whatever it holds -- with
// what its stdin, stdout and stderr are. It is a value, run once:
//   - as its full expression ends, where nothing used it (`git status;`):
//     in the foreground, the terminal its own while it runs -- Ctrl+C and
//     Ctrl+Z go to it -- its output straight to the terminal;
//   - where what it gives is used: its exit status (`if (git diff --quiet)`,
//     `make && ./a.out`: explicit operator bool), its output as a string
//     (`std::string head = git rev-parse HEAD;`, trimmed), or as lines,
//     streamed (`git log --oneline | take 5`: a range of line_entry);
//   - piped into another (`dmesg | grep usb`... a pipeline, one OS pipe
//     between each two), or fed a range (`ls | where _.is_dir() | xargs echo`:
//     its elements, a line each, its stdin).
// Redirects: `cmd > "out.txt"`, `cmd >> "log"`, `cmd < "in.txt"`,
// cmd.err_to_out() (2>&1). The exit status of the last run is last_status
// -- a pipeline's, its last failing stage's (pipefail).

inline int last_status = 0;

// A word of a command, from what was written: a string as it is; a number
// as it is written; an entry by its name; a range, a word per element.
inline void __cppsh_word(std::vector<std::string> &out, const char *v) { out.emplace_back(v); }
inline void __cppsh_word(std::vector<std::string> &out, std::string_view v) { out.emplace_back(v); }
inline void __cppsh_word(std::vector<std::string> &out, const std::string &v) { out.push_back(v); }
template <typename T>
void __cppsh_word(std::vector<std::string> &out, const T &v) {
  if constexpr (std::is_same_v<T, bool>)
    out.emplace_back(v ? "true" : "false");
  else if constexpr (std::is_arithmetic_v<T>)
    out.push_back(std::format("{}", v));
  else if constexpr (requires { std::string_view(v); })
    out.emplace_back(std::string_view(v));
  else if constexpr (requires { v.name; } || __cppsh_is_variant<T>)
    out.emplace_back(__cppsh_cstr(v));
  else if constexpr (std::ranges::input_range<T>)
    for (const auto &e : v)
      __cppsh_word(out, e);
  else
    out.push_back(std::format("{}", v));
}

#if __has_include(<spawn.h>)
// Whether the shell does job control: an interactive one, the leader of its
// own process group and the terminal's foreground group (what cppsh makes
// itself at its prompt). A script, or a test piped in, leaves the terminal
// and the process groups alone, as bash running a script does -- a crash
// then never leaves the terminal to a group of its own.
inline bool __cppsh_job_control() {
  return ::isatty(0) && ::getpgrp() == ::getpid() && ::tcgetpgrp(0) == ::getpgrp();
}

// A process started: argv, its stdin/stdout/stderr the descriptors given
// (-1: the shell's own), in the process group `group` (0: a new one, its
// own; without job control, the shell's). The descriptors the shell keeps
// for other stages are closed in it.
inline pid_t __cppsh_spawn(const std::vector<std::string> &argv, int in, int out,
                           int err, pid_t group, const std::vector<int> &close_fds) {
  posix_spawn_file_actions_t fa;
  posix_spawn_file_actions_init(&fa);
  if (in >= 0)
    posix_spawn_file_actions_adddup2(&fa, in, 0);
  if (out >= 0)
    posix_spawn_file_actions_adddup2(&fa, out, 1);
  if (err >= 0)
    posix_spawn_file_actions_adddup2(&fa, err, 2);
  for (int fd : close_fds)
    posix_spawn_file_actions_addclose(&fa, fd);
  posix_spawnattr_t at;
  posix_spawnattr_init(&at);
  const bool own_group = __cppsh_job_control();
  posix_spawnattr_setpgroup(&at, own_group ? group : ::getpgrp());
  // The signals the shell catches or ignores, as a program finds them.
  sigset_t def;
  sigemptyset(&def);
  for (int s : {SIGINT, SIGQUIT, SIGTSTP, SIGTTIN, SIGTTOU, SIGPIPE})
    sigaddset(&def, s);
  posix_spawnattr_setsigdefault(&at, &def);
  posix_spawnattr_setflags(&at, POSIX_SPAWN_SETPGROUP | POSIX_SPAWN_SETSIGDEF);
  std::vector<char *> args;
  for (const std::string &a : argv)
    args.push_back(const_cast<char *>(a.c_str()));
  args.push_back(nullptr);
  pid_t pid = -1;
  if (posix_spawnp(&pid, args[0], &fa, &at, args.data(), environ) != 0) {
    std::fprintf(stderr, "cppsh: %s: command not found\n", args[0]);
    pid = -1;
  }
  posix_spawn_file_actions_destroy(&fa);
  posix_spawnattr_destroy(&at);
  return pid;
}

// The terminal given to a foreground group while it runs, and taken back.
// Its modes too, as the shell had them: what a job set on the terminal (a
// pager raw, an editor without echo) and left so when it stopped or died is
// not the prompt's.
struct __cppsh_foreground {
  bool tty = __cppsh_job_control();
  termios modes{};
  bool have_modes = tty && ::tcgetattr(0, &modes) == 0;
  explicit __cppsh_foreground(pid_t group) {
    if (tty && group > 0)
      ::tcsetpgrp(0, group);
  }
  ~__cppsh_foreground() {
    if (!tty)
      return;
    // Taking it back from the background is a SIGTTOU: ignored for that.
    void (*was)(int) = ::signal(SIGTTOU, SIG_IGN);
    ::tcsetpgrp(0, ::getpgrp());
    if (have_modes)
      ::tcsetattr(0, TCSADRAIN, &modes);
    ::signal(SIGTTOU, was);
  }
};

// A process waited for: its status as a shell says it (128 + a signal).
inline int __cppsh_wait(pid_t pid) {
  if (pid <= 0)
    return 127;
  int st = 0;
  while (::waitpid(pid, &st, WUNTRACED) < 0)
    if (errno != EINTR)
      return 127;
  if (WIFEXITED(st))
    return WEXITSTATUS(st);
  if (WIFSIGNALED(st))
    return 128 + WTERMSIG(st);
  if (WIFSTOPPED(st)) {
    std::fprintf(stderr, "\n[stopped] %d\n", static_cast<int>(pid));
    return 128 + WSTOPSIG(st);
  }
  return 1;
}

// Jobs: what runs in the background, or was stopped (Ctrl+Z) -- each its
// process group, the processes of it not reaped yet, what was written.
struct __cppsh_job {
  int id = 0;
  pid_t group = 0;
  std::vector<pid_t> pids;
  std::string text;
  bool stopped = false;
};
inline std::vector<__cppsh_job> __cppsh_jobs;
inline int __cppsh_add_job(pid_t group, std::vector<pid_t> pids, std::string text,
                           bool stopped) {
  int id = 1;
  for (const __cppsh_job &j : __cppsh_jobs)
    id = std::max(id, j.id + 1);
  __cppsh_jobs.push_back({id, group, std::move(pids), std::move(text), stopped});
  return id;
}

// The processes of a foreground job waited for: its status (the last
// failing one's); stopped (Ctrl+Z), the job kept in the table, the rest of
// its processes with it.
inline int __cppsh_wait_job(const std::vector<pid_t> &pids, pid_t group,
                            const std::string &text) {
  int status = 0;
  for (std::size_t i = 0; i < pids.size(); ++i) {
    pid_t pid = pids[i];
    if (pid <= 0) {
      status = 127;
      continue;
    }
    int st = 0;
    bool lost = false;
    while (::waitpid(pid, &st, WUNTRACED) < 0)
      if (errno != EINTR) {
        lost = true;
        break;
      }
    if (lost) {
      status = 127;
      continue;
    }
    if (WIFSTOPPED(st)) {
      int id = __cppsh_add_job(group, std::vector<pid_t>(pids.begin() + i, pids.end()),
                               text, true);
      std::fprintf(stderr, "\n[%d]+  Stopped                 %s\n", id, text.c_str());
      return 128 + WSTOPSIG(st);
    }
    int s = WIFEXITED(st) ? WEXITSTATUS(st) : WIFSIGNALED(st) ? 128 + WTERMSIG(st) : 1;
    if (s != 0)
      status = s;
  }
  return status;
}

// The jobs that changed: reaped where their processes ended (`Done`), stopped
// or continued where a signal did that.
inline void __cppsh_reap_jobs() {
  for (__cppsh_job &j : __cppsh_jobs)
    std::erase_if(j.pids, [&](pid_t p) {
      int st = 0;
      pid_t r = ::waitpid(p, &st, WNOHANG | WUNTRACED | WCONTINUED);
      if (r == 0)
        return false;
      if (r < 0)
        return true;
      if (WIFSTOPPED(st)) {
        j.stopped = true;
        return false;
      }
      if (WIFCONTINUED(st)) {
        j.stopped = false;
        return false;
      }
      return true;
    });
  std::erase_if(__cppsh_jobs, [](const __cppsh_job &j) {
    if (!j.pids.empty())
      return false;
    std::fprintf(stderr, "[%d]+  Done                    %s\n", j.id, j.text.c_str());
    return true;
  });
}
#endif

// A job as `jobs` lists it.
struct job_entry {
  int id = 0;
  std::string state;
  long long pgid = 0;
  std::string command;
};

struct command {
  std::vector<std::string> argv;
  std::optional<std::string> in_file, out_file;
  bool append = false, err_to_out_ = false;
  // What its stdin is fed, where a range was piped into it.
  std::optional<std::string> input;
  // Run, or given over (moved, piped, consumed): not run again.
  bool done = false;

  command() = default;
  explicit command(std::vector<std::string> words) : argv(std::move(words)) {}
  command(const command &) = delete;
  command &operator=(const command &) = delete;
  command(command &&o) noexcept
      : argv(std::move(o.argv)), in_file(std::move(o.in_file)), out_file(std::move(o.out_file)),
        append(o.append), err_to_out_(o.err_to_out_), input(std::move(o.input)), done(o.done) {
    o.done = true;
  }
  command &operator=(command &&o) noexcept {
    if (this != &o) {
      if (!done)
        run();
      argv = std::move(o.argv);
      in_file = std::move(o.in_file);
      out_file = std::move(o.out_file);
      append = o.append;
      err_to_out_ = o.err_to_out_;
      input = std::move(o.input);
      done = o.done;
      o.done = true;
    }
    return *this;
  }
  // Nothing used it: it runs as its full expression ends.
  ~command() {
    if (!done)
      run();
  }

  command &&err_to_out() && {
    err_to_out_ = true;
    return std::move(*this);
  }

  // Run in the foreground, its output to the terminal (or its file): its
  // exit status.
  int run();
  // Run, its stdout taken: (status, what it wrote).
  std::pair<int, std::string> capture();

  int status() { return run(); }
  std::string out() { return capture().second; }
  explicit operator bool() { return run() == 0; }
  // Its output, trailing newlines off: `std::string h = git rev-parse HEAD;`.
  operator std::string() {
    std::string s = capture().second;
    while (!s.empty() && (s.back() == '\n' || s.back() == '\r'))
      s.pop_back();
    return s;
  }

  // Its output as lines, streamed as it writes them: a range of line_entry.
  struct state;
  struct iterator {
    using iterator_concept = std::input_iterator_tag;
    using value_type = line_entry;
    using difference_type = std::ptrdiff_t;
    std::shared_ptr<state> st;
    line_entry cur{};
    bool at_end = true;
    void next();
    const line_entry &operator*() const noexcept { return cur; }
    const line_entry *operator->() const noexcept { return &cur; }
    iterator &operator++() {
      next();
      return *this;
    }
    void operator++(int) { next(); }
    bool operator==(std::default_sentinel_t) const noexcept { return at_end; }
  };
  iterator begin();
  std::default_sentinel_t end() const noexcept { return std::default_sentinel; }
};

// Redirects.
template <typename Path>
  requires requires(const Path &p) { __cppsh_cstr(p); }
command &&operator>(command &&c, const Path &p) {
  c.out_file = __cppsh_cstr(p);
  c.append = false;
  return std::move(c);
}
template <typename Path>
  requires requires(const Path &p) { __cppsh_cstr(p); }
command &&operator>>(command &&c, const Path &p) {
  c.out_file = __cppsh_cstr(p);
  c.append = true;
  return std::move(c);
}
template <typename Path>
  requires requires(const Path &p) { __cppsh_cstr(p); }
command &&operator<(command &&c, const Path &p) {
  c.in_file = __cppsh_cstr(p);
  return std::move(c);
}

// Commands one after another, each's stdout the next's stdin.
struct pipeline {
  std::vector<command> stages;
  bool done = false;
  pipeline() = default;
  pipeline(const pipeline &) = delete;
  pipeline(pipeline &&o) noexcept : stages(std::move(o.stages)), done(o.done) { o.done = true; }
  ~pipeline() {
    if (!done)
      run();
  }
  // The stages run together; the status, the last failing stage's.
  std::pair<int, std::string> run_all(bool capture);
  int run() { return run_all(false).first; }
  std::string out() { return run_all(true).second; }
  explicit operator bool() { return run() == 0; }
  operator std::string() {
    std::string s = run_all(true).second;
    while (!s.empty() && (s.back() == '\n' || s.back() == '\r'))
      s.pop_back();
    return s;
  }
  // Its output as lines: the stages run, the last one's output read whole.
  std::vector<line_entry> lines() {
    std::vector<line_entry> out_lines;
    std::string all = run_all(true).second;
    long long n = 0;
    std::size_t from = 0;
    while (from < all.size()) {
      std::size_t to = all.find('\n', from);
      if (to == std::string::npos)
        to = all.size();
      std::string s = all.substr(from, to - from);
      if (!s.empty() && s.back() == '\r')
        s.pop_back();
      long long sz = static_cast<long long>(s.size());
      out_lines.push_back(line_entry{++n, std::move(s), sz});
      from = to + 1;
    }
    return out_lines;
  }
  auto begin() {
    held_ = lines();
    return held_.begin();
  }
  auto end() { return held_.end(); }
  std::vector<line_entry> held_;
};

