namespace std {

template <typename T>
constexpr const char *__cppsh_cstr(const T &v) {
  if constexpr (requires { v.c_str(); })
    return v.c_str();
  else if constexpr (requires { v.name.c_str(); })
    return v.name.c_str();
  else if constexpr (__cppsh_is_variant<T>)
    return std::visit([](const auto &a) { return __cppsh_cstr(a); }, v);
  else
    return static_cast<const char *>(v);
}

// An element as a line of text: its name or text, else as it formats.
template <typename T>
std::string __cppsh_cstr_or_format(const T &v) {
  if constexpr (requires { v.text; })
    return std::string(v.text);
  else if constexpr (requires { std::string_view(v); })
    return std::string(std::string_view(v));
  else if constexpr (requires { v.name; } || __cppsh_is_variant<T>)
    return std::string(__cppsh_cstr(v));
  else
    return std::format("{}", v);
}

template <typename T>
void print(const T &v) {
  if constexpr (requires { v.dump(); })
    v.dump();
  else if constexpr (requires { std::cout << v; })
    std::cout << v << '\n';
}

