// Each stage spawned, the pipes between them, the first's stdin fed where
// a range was piped in, the last's stdout read where it is captured.
inline std::pair<int, std::string> __cppsh_run_stages(std::vector<command *> stages,
                                                      bool capture, bool background = false) {
  std::vector<int> all_fds;
  std::vector<std::pair<int, int>> pipes;
  for (std::size_t i = 0; i + 1 < stages.size(); ++i) {
    int fds[2];
    if (::pipe(fds) != 0)
      return {127, {}};
    pipes.push_back({fds[0], fds[1]});
    all_fds.push_back(fds[0]);
    all_fds.push_back(fds[1]);
  }
  int feed[2] = {-1, -1}, take[2] = {-1, -1};
  if (stages.front()->input && ::pipe(feed) == 0) {
    all_fds.push_back(feed[0]);
    all_fds.push_back(feed[1]);
  }
  if (capture && ::pipe(take) == 0) {
    all_fds.push_back(take[0]);
    all_fds.push_back(take[1]);
  }
  std::vector<int> files;
  std::vector<pid_t> pids;
  pid_t group = 0;
  for (std::size_t i = 0; i < stages.size(); ++i) {
    command &c = *stages[i];
    int in = i > 0 ? pipes[i - 1].first : feed[0];
    int out = i + 1 < stages.size() ? pipes[i].second : take[1];
    if (c.in_file) {
      int fd = ::open(c.in_file->c_str(), O_RDONLY | O_CLOEXEC);
      if (fd >= 0) {
        files.push_back(fd);
        in = fd;
      }
    }
    if (c.out_file) {
      int fd = ::open(c.out_file->c_str(),
                      O_WRONLY | O_CREAT | O_CLOEXEC | (c.append ? O_APPEND : O_TRUNC), 0644);
      if (fd >= 0) {
        files.push_back(fd);
        out = fd;
      }
    }
    int err = c.err_to_out_ ? (out >= 0 ? out : 1) : -1;
    pid_t pid = __cppsh_spawn(c.argv, in, out, err, group, all_fds);
    if (group == 0 && pid > 0)
      group = pid;
    pids.push_back(pid);
    c.done = true;
  }
  for (std::size_t i = 0; i < all_fds.size(); ++i)
    if (all_fds[i] != feed[1] && all_fds[i] != take[0])
      ::close(all_fds[i]);
  for (int fd : files)
    ::close(fd);
  // stdin fed on a thread of its own: a child writing a lot and reading
  // a lot would block either side otherwise.
  std::thread feeder;
  if (feed[1] >= 0) {
    feeder = std::thread([fd = feed[1], data = *stages.front()->input] {
      std::size_t off = 0;
      while (off < data.size()) {
        ssize_t n = ::write(fd, data.data() + off, data.size() - off);
        if (n <= 0)
          break;
        off += static_cast<std::size_t>(n);
      }
      ::close(fd);
    });
  }
  // What was written, for the job table: argv, ` | ` between stages.
  std::string text;
  for (command *c : stages) {
    if (!text.empty())
      text += " | ";
    for (std::size_t w = 0; w < c->argv.size(); ++w)
      text += (w ? " " : "") + c->argv[w];
  }
  if (background) {
    // Started, not waited for: a job, reaped as `jobs` (or the next one)
    // looks; the terminal stays the shell's.
    if (feeder.joinable())
      feeder.detach();
    int id = __cppsh_add_job(group, pids, text, false);
    std::fprintf(stderr, "[%d] %d\n", id, static_cast<int>(group));
    last_status = 0;
    return {0, {}};
  }
  std::string got;
  int status = 0;
  {
    // The terminal the group's while it runs, captured or not: what it
    // asks the user (a password, a pager) reaches them.
    __cppsh_foreground fg(group);
    if (take[0] >= 0) {
      char buf[4096];
      ssize_t n;
      while ((n = ::read(take[0], buf, sizeof buf)) > 0 || (n < 0 && errno == EINTR))
        if (n > 0)
          got.append(buf, static_cast<std::size_t>(n));
      ::close(take[0]);
    }
    status = __cppsh_wait_job(pids, group, text);
  }
  if (feeder.joinable())
    feeder.join();
  last_status = status;
  return {status, std::move(got)};
}

inline int command::run() {
  if (done)
    return last_status;
  return __cppsh_run_stages({this}, false).first;
}
inline std::pair<int, std::string> command::capture() {
  if (done)
    return {last_status, {}};
  return __cppsh_run_stages({this}, true);
}
inline std::pair<int, std::string> pipeline::run_all(bool capture) {
  done = true;
  std::vector<command *> all;
  for (command &c : stages)
    all.push_back(&c);
  if (all.empty())
    return {0, {}};
  return __cppsh_run_stages(std::move(all), capture);
}

