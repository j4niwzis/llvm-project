    in = ::open(in_file->c_str(), O_RDONLY | O_CLOEXEC);
  pid_t pid = __cppsh_spawn(argv, in, fds[1], err_to_out_ ? fds[1] : -1, 0, {fds[0]});
  ::close(fds[1]);
