}

// The job of an id -- the last one where none is given.
inline __cppsh_job *__cppsh_job_of(int id) {
  __cppsh_reap_jobs();
  if (__cppsh_jobs.empty())
    return nullptr;
  if (id <= 0)
    return &__cppsh_jobs.back();
  for (__cppsh_job &j : __cppsh_jobs)
    if (j.id == id)
      return &j;
  return nullptr;
}

// A job brought to the foreground: continued where stopped, the terminal
// its group's, waited for; its status.
inline int fg(int id = 0) {
  __cppsh_job *j = __cppsh_job_of(id);
  if (!j) {
    std::fprintf(stderr, "cppsh: fg: no such job\n");
    return last_status = 1;
  }
  __cppsh_job job = *j;
  std::erase_if(__cppsh_jobs, [&](const __cppsh_job &x) { return x.id == job.id; });
  std::fprintf(stderr, "%s\n", job.text.c_str());
  int status;
  {
    __cppsh_foreground fore(job.group);
    if (job.stopped)
      ::kill(-job.group, SIGCONT);
    status = __cppsh_wait_job(job.pids, job.group, job.text);
  }
  return last_status = status;
}

// A stopped job continued in the background.
inline int bg(int id = 0) {
  __cppsh_job *j = __cppsh_job_of(id);
  if (!j) {
    std::fprintf(stderr, "cppsh: bg: no such job\n");
    return last_status = 1;
  }
  ::kill(-j->group, SIGCONT);
  j->stopped = false;
  std::fprintf(stderr, "[%d]+ %s &\n", j->id, j->text.c_str());
  return last_status = 0;
}

