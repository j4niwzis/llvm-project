template <char... Cs>
struct sym {
  static constexpr const char value[sizeof...(Cs) + 1] = {Cs..., '\0'};
  constexpr operator const char *() const noexcept { return value; }
  operator std::string() const { return std::string(value, sizeof...(Cs)); }
  constexpr operator std::string_view() const noexcept {
    return std::string_view(value, sizeof...(Cs));
  }
  constexpr const char *c_str() const noexcept { return value; }
  constexpr std::size_t size() const noexcept { return sizeof...(Cs); }
  template <char... NextCs>
  constexpr auto operator_unresolved() const noexcept {
    return sym<Cs..., '.', NextCs...>{};
  }
  constexpr auto operator-() const noexcept { return sym<'-', Cs...>{}; }
  constexpr auto operator--() const noexcept { return sym<'-', '-', Cs...>{}; }
  template <char... RCs>
  constexpr auto operator-(sym<RCs...>) const noexcept {
    return sym<Cs..., '-', RCs...>{};
  }
  template <char... RCs>
  constexpr auto operator/(sym<RCs...>) const noexcept {
    return sym<Cs..., '/', RCs...>{};
  }
  template <typename... Args>
  int operator()(Args &&...args) const {
    std::ostringstream cmd;
    cmd << value;
    ((cmd << ' ' << args), ...);
    return std::system(cmd.str().c_str());
  }
};

template <char... Cs>
constexpr auto operator_unresolved() noexcept {
  return sym<Cs...>{};
}

// What `ls` lists, each kind a type of its own: what an entry is, is which
// of them it is -- in a range of all kinds, the alternative of a variant
// (fs_entry) -- not a flag it stores.
struct file_entry {
  std::string name;
  std::string ext;
  long long size = 0;
  constexpr bool is_dir() const noexcept { return false; }
  void dump() const {
    std::printf("[file] %-28s %10lld B\n", name.c_str(), size);
  }
};
struct dir_entry {
  std::string name;
  constexpr bool is_dir() const noexcept { return true; }
  void dump() const { std::printf("[dir]  %s/\n", name.c_str()); }
};
struct link_entry {
  std::string name;
  std::string target;
  constexpr bool is_dir() const noexcept { return false; }
  void dump() const {
    std::printf("[link] %s -> %s\n", name.c_str(), target.c_str());
  }
};
using fs_entry = std::variant<file_entry, dir_entry, link_entry>;

struct ls_opts {
  bool all = false;
  bool recursive = false;
  bool dirs_only = false;
  bool files_only = false;
};

struct line_entry {
  long long num = 0;
  std::string text;
  long long size = 0;
  bool empty() const noexcept { return text.empty(); }
  bool contains(std::string_view s) const noexcept {
    return text.find(s) != std::string::npos;
  }
  bool starts_with(std::string_view s) const noexcept {
    return text.starts_with(s);
  }
  bool ends_with(std::string_view s) const noexcept {
    return text.ends_with(s);
  }
  const char *c_str() const noexcept { return text.c_str(); }
  void dump() const { std::printf("%4lld | %s\n", num, text.c_str()); }
};

struct lines_view : public std::ranges::view_interface<lines_view> {
  std::string path;

  struct iterator {
    using iterator_concept = std::input_iterator_tag;
    using iterator_category = std::input_iterator_tag;
    using value_type = line_entry;
    using difference_type = std::ptrdiff_t;

    std::shared_ptr<std::ifstream> stream;
    long long line_no = 0;
    line_entry cur{};
    bool at_end = true;

    iterator() = default;
    explicit iterator(const std::string &p)
        : stream(std::make_shared<std::ifstream>(p)) {
      if (stream && stream->is_open()) {
        at_end = false;
        next();
      }
    }

    void next() {
      if (!stream) {
        at_end = true;
        return;
      }
      std::string s;
      if (!std::getline(*stream, s)) {
        stream.reset();
        at_end = true;
        return;
      }
      if (!s.empty() && s.back() == '\r')
        s.pop_back();
      ++line_no;
      long long sz = static_cast<long long>(s.size());
      cur = line_entry{line_no, std::move(s), sz};
    }

    const line_entry &operator*() const noexcept { return cur; }
    const line_entry *operator->() const noexcept { return &cur; }
    iterator &operator++() {
      next();
      return *this;
    }
    void operator++(int) { ++*this; }
    bool operator==(std::default_sentinel_t) const noexcept { return at_end; }
  };

  lines_view() = default;
  explicit lines_view(std::string p) : path(std::move(p)) {}

  iterator begin() const { return iterator(path); }
  constexpr std::default_sentinel_t end() const noexcept {
    return std::default_sentinel;
  }
};

// A directory entry made into what a listing of Entry holds -- false where
// it is not one (a directory, listing files). Overloaded on what is made.
inline bool __cppsh_make_entry(const std::filesystem::directory_entry &de,
                               std::string name, file_entry &out) {
  std::error_code ec;
  if (de.is_directory(ec))
    return false;
  long long size = 0;
  auto raw = de.file_size(ec);
  if (!ec)
    size = static_cast<long long>(raw);
  out = file_entry{std::move(name), de.path().extension().string(), size};
  return true;
}
inline bool __cppsh_make_entry(const std::filesystem::directory_entry &de,
                               std::string name, dir_entry &out) {
  std::error_code ec;
  if (!de.is_directory(ec))
    return false;
  out = dir_entry{std::move(name)};
  return true;
}
inline bool __cppsh_make_entry(const std::filesystem::directory_entry &de,
                               std::string name, fs_entry &out) {
  std::error_code ec;
  if (de.is_symlink(ec)) {
    out = link_entry{std::move(name), std::filesystem::read_symlink(de.path(), ec).string()};
    return true;
  }
  if (de.is_directory(ec)) {
    out = dir_entry{std::move(name)};
    return true;
  }
  file_entry file;
  __cppsh_make_entry(de, std::move(name), file);
  out = std::move(file);
  return true;
}

template <typename Entry = fs_entry>
struct ls_view : public std::ranges::view_interface<ls_view<Entry>> {
  std::string dir = ".";
  ls_opts opts{};

  struct iterator {
    using iterator_concept = std::input_iterator_tag;
    using iterator_category = std::input_iterator_tag;
    using value_type = Entry;
    using difference_type = std::ptrdiff_t;

    std::filesystem::directory_iterator it;
    ls_opts opts{};
    Entry cur{};

    iterator() = default;
    iterator(const std::string &d, ls_opts o) : opts(o) {
      std::error_code ec;
      it = std::filesystem::directory_iterator(
          d, std::filesystem::directory_options::skip_permission_denied, ec);
      if (ec)
        it = std::filesystem::directory_iterator{};
      advance_to_valid();
    }

    void advance_to_valid() {
      std::error_code ec;
      while (it != std::filesystem::directory_iterator{}) {
        const auto &de = *it;
        std::string fname = de.path().filename().string();
        // Hidden ones, and those the options leave out where the options
        // were not known as the call was compiled (a listing of all kinds).
        bool isDir = de.is_directory(ec);
        if ((!opts.all && !fname.empty() && fname[0] == '.') ||
            (opts.dirs_only && !isDir) || (opts.files_only && isDir) ||
            !__cppsh_make_entry(de, std::move(fname), cur)) {
          it.increment(ec);
          continue;
        }
        return;
      }
    }

    const Entry &operator*() const noexcept { return cur; }
    const Entry *operator->() const noexcept { return &cur; }
    iterator &operator++() {
      std::error_code ec;
      it.increment(ec);
      advance_to_valid();
      return *this;
    }
    void operator++(int) { ++*this; }
    bool operator==(std::default_sentinel_t) const noexcept {
      return it == std::filesystem::directory_iterator{};
    }
  };

  ls_view() = default;
  ls_view(std::string d, ls_opts o) : dir(std::move(d)), opts(o) {}

  iterator begin() const { return iterator(dir, opts); }
  constexpr std::default_sentinel_t end() const noexcept {
    return std::default_sentinel;
  }
};

template <typename Path>
inline std::string read_file(const Path &p) {
  std::ifstream ifs(__cppsh_cstr(p), std::ios::binary);
  if (!ifs)
    return {};
  std::ostringstream oss;
  oss << ifs.rdbuf();
  return oss.str();
}

template <typename Path>
inline lines_view read_lines(const Path &p) {
  return lines_view(std::string(__cppsh_cstr(p)));
}

template <typename Path>
inline lines_view lines(const Path &p) {
  return read_lines(p);
}

template <typename Path, typename Content>
inline bool write_file(const Path &p, const Content &c) {
  std::ofstream ofs(__cppsh_cstr(p), std::ios::binary | std::ios::trunc);
  if (!ofs)
    return false;
  ofs << __cppsh_cstr(c);
  return ofs.good();
}

template <typename Path, typename Content>
inline bool append_file(const Path &p, const Content &c) {
  std::ofstream ofs(__cppsh_cstr(p), std::ios::binary | std::ios::app);
  if (!ofs)
    return false;
  ofs << __cppsh_cstr(c);
  return ofs.good();
}

template <typename Path>
inline bool file_exists(const Path &p) {
  std::error_code ec;
  return std::filesystem::exists(__cppsh_cstr(p), ec);
}

// `ls "-a"`: the flags in place of a directory.
template <typename Entry, typename Dir>
inline ls_view<Entry> __cppsh_ls_view(const Dir &d, ls_opts opts) {
  const char *dir = __cppsh_cstr(d);
  if (dir && dir[0] == '-') {
    for (const char *p = dir + 1; *p; ++p)
      if (*p == 'a')
        opts.all = true;
    dir = ".";
  }
  return ls_view<Entry>(std::string(dir ? dir : "."), opts);
}

// What a listing holds, by its options: files, directories, or every kind
// -- a variant, each entry its alternative. The options are known as the
// call is compiled (the value specialization folds these `if`s), so each
// set of them gives its own type.
template <typename Dir = const char *>
inline auto ls(Dir dir = ".", ls_opts opts = {}) {
  if (opts.files_only)
    return __cppsh_ls_view<file_entry>(dir, opts);
  else if (opts.dirs_only)
    return __cppsh_ls_view<dir_entry>(dir, opts);
  else
    return __cppsh_ls_view<fs_entry>(dir, opts);
}
// `ls {.files_only = true}`: the options alone.
template <typename = void>
inline auto ls(ls_opts opts) {
  if (opts.files_only)
    return __cppsh_ls_view<file_entry>(".", opts);
  else if (opts.dirs_only)
    return __cppsh_ls_view<dir_entry>(".", opts);
  else
    return __cppsh_ls_view<fs_entry>(".", opts);
}

// Whether an entry is a directory: by its kind, or the kind a variant holds.
template <typename E>
constexpr bool is_dir(const E &e) noexcept {
  if constexpr (__cppsh_is_variant<E>)
    return std::visit([](const auto &a) { return a.is_dir(); }, e);
  else
    return e.is_dir();
}

template <typename Path>
inline void cat(const Path &p) {
  std::ifstream ifs(__cppsh_cstr(p));
  if (!ifs)
    return;
  std::cout << ifs.rdbuf();
}

inline std::string pwd() {
  std::error_code ec;
  return std::filesystem::current_path(ec).string();
}

template <typename Path>
inline int cd(const Path &p) {
  std::error_code ec;
  std::filesystem::current_path(__cppsh_cstr(p), ec);
  return ec ? -1 : 0;
}

template <typename Name>
inline std::string env(const Name &n) {
  const char *v = std::getenv(__cppsh_cstr(n));
  return v ? std::string(v) : std::string{};
}

template <typename Name, typename Val>
inline bool setenv(const Name &n, const Val &v, bool overwrite = true) {
  return ::setenv(__cppsh_cstr(n), __cppsh_cstr(v), overwrite ? 1 : 0) == 0;
}

template <typename Path>
inline bool exists(const Path &p) {
  return file_exists(p);
}

template <typename Path>
inline bool mkdir_p(const Path &p) {
  std::error_code ec;
  std::filesystem::create_directories(__cppsh_cstr(p), ec);
  return !ec;
}

template <typename Path>
inline bool rm(const Path &p) {
  std::error_code ec;
  std::filesystem::remove_all(__cppsh_cstr(p), ec);
  return !ec;
}

template <typename Src, typename Dst>
inline bool cp(const Src &src, const Dst &dst) {
  std::error_code ec;
  std::filesystem::copy(
      __cppsh_cstr(src), __cppsh_cstr(dst),
      std::filesystem::copy_options::recursive |
          std::filesystem::copy_options::overwrite_existing,
      ec);
  return !ec;
}

template <typename Src, typename Dst>
inline bool mv(const Src &src, const Dst &dst) {
  std::error_code ec;
  std::filesystem::rename(__cppsh_cstr(src), __cppsh_cstr(dst), ec);
  return !ec;
}

template <typename Path>
inline bool touch(const Path &p) {
  std::ofstream ofs(__cppsh_cstr(p), std::ios::app);
  return ofs.good();
}

template <typename Path>
inline auto head(const Path &p, std::ptrdiff_t n = 10) {
  return lines(p) | std::ranges::views::take(n);
}

template <typename Path>
inline std::vector<line_entry> tail(const Path &p, std::size_t n = 10) {
  std::vector<line_entry> all;
  for (auto &&le : lines(p))
    all.push_back(std::move(le));
  if (all.size() > n)
    all.erase(all.begin(), all.begin() + static_cast<std::ptrdiff_t>(all.size() - n));
  return all;
}

template <typename Path>
inline long long wc_l(const Path &p) {
  long long cnt = 0;
  for (auto &&le : lines(p)) {
    (void)le;
    ++cnt;
  }
  return cnt;
}

template <typename Dir = const char *>
inline auto glob(Dir dir = ".", ls_opts opts = {}) {
  return ls(dir, opts);
}

struct sh_result {
  int code = 0;
  std::string out;
  constexpr explicit operator bool() const noexcept { return code == 0; }
  void dump() const { std::printf("%s", out.c_str()); }
};

template <typename Cmd>
inline int run(const Cmd &cmd) {
  return std::system(__cppsh_cstr(cmd));
}

template <typename Cmd>
inline sh_result exec(const Cmd &cmd) {
  sh_result res;
  FILE *fp = ::popen(__cppsh_cstr(cmd), "r");
  if (!fp) {
    res.code = -1;
    return res;
  }
  char buf[1024];
  while (std::fgets(buf, sizeof(buf), fp))
    res.out += buf;
  res.code = ::pclose(fp);
  return res;
}

