inline void command::iterator::next() {
  if (!st || !st->in) {
    at_end = true;
    st.reset();
    return;
  }
  char *line = nullptr;
  std::size_t cap = 0;
  ssize_t n = ::getline(&line, &cap, st->in);
  if (n < 0) {
    std::free(line);
    at_end = true;
    st.reset();
    return;
  }
  std::string s(line, static_cast<std::size_t>(n));
  std::free(line);
  while (!s.empty() && (s.back() == '\n' || s.back() == '\r'))
    s.pop_back();
  long long sz = static_cast<long long>(s.size());
  cur = line_entry{++st->line_no, std::move(s), sz};
}
