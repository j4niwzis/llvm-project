struct info {
  unsigned long long id = 0;
  unsigned int kind = 0;
  const char *name = nullptr;
  const info *members = nullptr;
  unsigned int num_members = 0;

  constexpr bool operator==(const info &o) const noexcept {
    return id == o.id && kind == o.kind;
  }
  constexpr bool operator!=(const info &o) const noexcept {
    return !(*this == o);
  }
};

struct info_range {
  const info *data_ = nullptr;
  unsigned int size_ = 0;
  constexpr const info *begin() const noexcept { return data_; }
  constexpr const info *end() const noexcept { return data_ + size_; }
  constexpr unsigned int size() const noexcept { return size_; }
  constexpr bool empty() const noexcept { return size_ == 0; }
  constexpr const info &operator[](unsigned int i) const noexcept {
    return data_[i];
  }
};

template <typename T>
constexpr info __reflect() noexcept {
  return {};
}

template <unsigned long long Id, typename... Args>
constexpr decltype(auto) __splice_call(Args &&...args);

constexpr const char *identifier_of(info r) noexcept {
  return r.name ? r.name : "";
}
constexpr bool is_type(info r) noexcept { return r.kind == 1; }
constexpr bool is_nonstatic_data_member(info r) noexcept { return r.kind == 2; }
constexpr bool is_member_function(info r) noexcept { return r.kind == 3; }
constexpr bool is_function(info r) noexcept {
  return r.kind == 3 || r.kind == 4;
}
constexpr info remove_cvref(info r) noexcept { return r; }
constexpr info_range members_of(info r) noexcept {
  return {r.members, r.num_members};
}

constexpr bool __streq(const char *a, const char *b) noexcept {
  if (!a || !b)
    return false;
  while (*a && *b) {
    if (*a != *b)
      return false;
    ++a;
    ++b;
  }
  return *a == *b;
}

constexpr info find_member(info r, const char *target) noexcept {
  for (info m : members_of(r))
    if (__streq(identifier_of(m), target))
      return m;
  return {};
}

} // namespace meta

template <typename F>
struct cppsh_proj;

template <typename T>
inline constexpr bool __cppsh_is_proj = false;
template <typename F>
inline constexpr bool __cppsh_is_proj<cppsh_proj<F>> = true;

template <typename Arg, typename... Xs>
  requires (!__cppsh_is_proj<std::remove_cvref_t<Arg>>)
constexpr Arg &&__cppsh_eval_arg(Arg &&arg, Xs &&...) noexcept {
  return static_cast<Arg &&>(arg);
}

template <typename Arg, typename... Xs>
  requires (__cppsh_is_proj<std::remove_cvref_t<Arg>>)
constexpr auto __cppsh_eval_arg(Arg &&arg, Xs &&...xs)
    -> decltype(static_cast<Arg &&>(arg)(static_cast<Xs &&>(xs)...)) {
  return static_cast<Arg &&>(arg)(static_cast<Xs &&>(xs)...);
}

template <typename Obj, unsigned long long MemId>
struct __cppsh_bound_member {
  Obj obj;
  template <typename... Args>
  constexpr decltype(auto) operator()(Args &&...args) {
    constexpr meta::info mem{MemId, 3};
    return obj.[:mem:](static_cast<Args &&>(args)...);
  }
  template <typename... Args>
  constexpr decltype(auto) operator()(Args &&...args) const {
    constexpr meta::info mem{MemId, 3};
    return obj.[:mem:](static_cast<Args &&>(args)...);
  }
};

template <typename T>
inline constexpr bool __cppsh_is_variant = false;
template <typename... Ts>
inline constexpr bool __cppsh_is_variant<std::variant<Ts...>> = true;

// `_.f(...)` on a variant (an entry of `ls`): f a member function of every
// alternative, called on the one held -- each alternative's f giving the
// same type.
template <char... Cs, typename... As>
consteval bool __cppsh_alts_have_method(std::type_identity<std::variant<As...>>) {
  constexpr char name[] = {Cs..., '\0'};
  return (meta::is_member_function(meta::find_member(^^As, name)) && ...);
}
template <typename Obj, char... Cs>
struct __cppsh_variant_bound_member {
  Obj obj;
  static constexpr const char name[] = {Cs..., '\0'};
  template <typename... Args>
  constexpr decltype(auto) operator()(Args &&...args) const {
    return std::visit(
        [&](auto &&alt) -> decltype(auto) {
          using A = std::remove_cvref_t<decltype(alt)>;
          constexpr meta::info mem = meta::find_member(^^A, name);
          return static_cast<decltype(alt) &&>(alt).[:mem:](
              static_cast<Args &&>(args)...);
        },
        static_cast<Obj>(obj));
  }
};

// A list of types, each once: what the alternatives of a variant give.
template <typename... Ts>
struct __cppsh_types {};
template <typename List, typename T>
struct __cppsh_push_unique;
template <typename... Ts, typename T>
struct __cppsh_push_unique<__cppsh_types<Ts...>, T> {
  using type = std::conditional_t<(std::is_same_v<T, Ts> || ...),
                                  __cppsh_types<Ts...>, __cppsh_types<Ts..., T>>;
};

// What a member access gives on a variant (Self: the access, which says of
// an alternative whether it has the member and what it is):
//   every alternative has it, of one type   -> that type
//   every alternative has it, of several    -> std::variant of them
//   some lack it, those that have it agree  -> std::optional of it
//   some lack it, the others do not agree   -> std::variant<monostate, ...>
// -- so `_.size > 10_KB` is false for a directory (an empty optional is less
// than any value) and `_.name` on any entry is a plain string.
template <typename Self, typename A, bool = Self::template alt_has<A>()>
struct __cppsh_alt_member {
  using type = void;
};
template <typename Self, typename A>
struct __cppsh_alt_member<Self, A, true> {
  using type = std::remove_cvref_t<decltype(Self::alt_member(std::declval<A &>()))>;
};
template <typename Self, typename List, typename... As>
struct __cppsh_collect_members {
  using type = List;
};
template <typename Self, typename List, typename A, typename... As>
struct __cppsh_collect_members<Self, List, A, As...> {
  using next = std::conditional_t<
      Self::template alt_has<A>(),
      typename __cppsh_push_unique<List, typename __cppsh_alt_member<Self, A>::type>::type,
      List>;
  using type = typename __cppsh_collect_members<Self, next, As...>::type;
};
template <bool All, typename List>
struct __cppsh_member_result;
template <typename T>
struct __cppsh_member_result<true, __cppsh_types<T>> {
  using type = T;
};
template <typename... Ts>
struct __cppsh_member_result<true, __cppsh_types<Ts...>> {
  using type = std::variant<Ts...>;
};
template <typename T>
struct __cppsh_member_result<false, __cppsh_types<T>> {
  using type = std::optional<T>;
};
template <typename... Ts>
struct __cppsh_member_result<false, __cppsh_types<Ts...>> {
  using type = std::variant<std::monostate, Ts...>;
};
template <typename Self, typename V>
struct __cppsh_variant_member;
template <typename Self, typename... As>
struct __cppsh_variant_member<Self, std::variant<As...>> {
  static constexpr bool any = (Self::template alt_has<As>() || ...);
  static constexpr bool all = (Self::template alt_has<As>() && ...);
  using type = typename __cppsh_member_result<
      all, typename __cppsh_collect_members<Self, __cppsh_types<>, As...>::type>::type;
};

template <typename Prev, char... Cs>
struct __cppsh_member_fn {
  Prev prev;
  static constexpr const char name[sizeof...(Cs) + 1] = {Cs..., '\0'};

  template <typename... Xs>
  static consteval bool is_data_member_eval() {
    if constexpr (sizeof...(Xs) == 0) {
      return false;
    } else if constexpr (requires {
                           std::declval<const Prev &>()(std::declval<Xs>()...);
                         }) {
      using ObjT =
          decltype(std::declval<const Prev &>()(std::declval<Xs>()...));
      constexpr meta::info mem = meta::find_member(^^ObjT, name);
      return meta::is_nonstatic_data_member(mem);
    } else {
      return false;
    }
  }

  template <typename... Xs>
  static consteval bool is_method_eval() {
    if constexpr (sizeof...(Xs) == 0) {
      return false;
    } else if constexpr (requires {
                           std::declval<const Prev &>()(std::declval<Xs>()...);
                         }) {
      using ObjT =
          decltype(std::declval<const Prev &>()(std::declval<Xs>()...));
      using B = std::remove_cvref_t<ObjT>;
      if constexpr (__cppsh_is_variant<B>) {
        return __cppsh_alts_have_method<Cs...>(std::type_identity<B>{});
      } else {
        constexpr meta::info mem = meta::find_member(^^ObjT, name);
        return meta::is_member_function(mem);
      }
    } else {
      return false;
    }
  }

  template <typename... Xs>
    requires (is_data_member_eval<Xs...>())
  constexpr decltype(auto) operator()(Xs &&...xs) const {
    auto &&obj = prev(static_cast<Xs &&>(xs)...);
    constexpr meta::info mem = meta::find_member(^^decltype(obj), name);
    return obj.[:mem:];
  }

  // On a variant (an entry of `ls`: a file, a directory or a link): the
  // member of whichever alternative it holds, as __cppsh_variant_member
  // says -- the alternative is the entry's kind, stored nowhere else.
  template <typename A>
  static consteval bool alt_has() {
    using B = std::remove_cvref_t<A>;
    return meta::is_nonstatic_data_member(meta::find_member(^^B, name));
  }
  template <typename A>
  static constexpr decltype(auto) alt_member(A &&a) {
    using B = std::remove_cvref_t<A>;
    constexpr meta::info mem = meta::find_member(^^B, name);
    return (static_cast<A &&>(a).[:mem:]);
  }
  template <typename... Xs>
  static consteval bool is_variant_member_eval() {
    if constexpr (sizeof...(Xs) == 0) {
      return false;
    } else if constexpr (requires {
                           std::declval<const Prev &>()(std::declval<Xs>()...);
                         }) {
      using ObjT = std::remove_cvref_t<
          decltype(std::declval<const Prev &>()(std::declval<Xs>()...))>;
      if constexpr (__cppsh_is_variant<ObjT>)
        return __cppsh_variant_member<__cppsh_member_fn, ObjT>::any;
      else
        return false;
    } else {
      return false;
    }
  }
  template <typename... Xs>
    requires (is_variant_member_eval<Xs...>())
  constexpr auto operator()(Xs &&...xs) const {
    auto &&obj = prev(static_cast<Xs &&>(xs)...);
    using V = std::remove_cvref_t<decltype(obj)>;
    using R = typename __cppsh_variant_member<__cppsh_member_fn, V>::type;
    return std::visit(
        [](auto &&alt) -> R {
          using A = std::remove_cvref_t<decltype(alt)>;
          if constexpr (alt_has<A>())
            return R(alt_member(alt));
          else
            return R{};
        },
        static_cast<decltype(obj) &&>(obj));
  }

  template <typename... Xs>
    requires (is_method_eval<Xs...>())
  constexpr auto bind_obj(Xs &&...xs) const {
    using ObjT = decltype(prev(static_cast<Xs &&>(xs)...));
    if constexpr (__cppsh_is_variant<std::remove_cvref_t<ObjT>>) {
      return __cppsh_variant_bound_member<ObjT, Cs...>{
          prev(static_cast<Xs &&>(xs)...)};
    } else {
      constexpr meta::info mem = meta::find_member(^^ObjT, name);
      return __cppsh_bound_member<ObjT, mem.id>{
          prev(static_cast<Xs &&>(xs)...)};
    }
  }
};

template <typename T>
inline constexpr bool __cppsh_is_member_fn = false;
template <typename Prev, char... Cs>
inline constexpr bool __cppsh_is_member_fn<__cppsh_member_fn<Prev, Cs...>> =
    true;

template <typename F, typename... Args>
inline constexpr bool __cppsh_is_data_member_eval = false;
template <typename Prev, char... Cs, typename... Args>
inline constexpr bool
    __cppsh_is_data_member_eval<__cppsh_member_fn<Prev, Cs...>, Args...> =
        __cppsh_member_fn<Prev, Cs...>::template is_data_member_eval<Args...>() ||
        __cppsh_member_fn<Prev, Cs...>::template is_variant_member_eval<Args...>();

template <typename MemberFn, typename CallLambda>
struct __cppsh_call_fn {
  MemberFn mem_fn;
  CallLambda call_fn;
  template <typename... Xs>
    requires (MemberFn::template is_method_eval<Xs...>())
  constexpr decltype(auto) operator()(Xs &&...xs) const {
    return call_fn(static_cast<Xs &&>(xs)...);
  }
};

template <typename F>
struct cppsh_proj {
  F fn;

  constexpr cppsh_proj() = default;
  constexpr explicit cppsh_proj(F f) : fn(static_cast<F &&>(f)) {}
  constexpr cppsh_proj(const cppsh_proj &) = default;
  constexpr cppsh_proj(cppsh_proj &&) = default;
  constexpr cppsh_proj &operator=(const cppsh_proj &) = default;
  constexpr cppsh_proj &operator=(cppsh_proj &&) = default;

  template <typename... Args>
    requires (!__cppsh_is_member_fn<F> &&
              requires { fn(std::declval<Args>()...); })
  constexpr decltype(auto) operator()(Args &&...args) const {
    return fn(static_cast<Args &&>(args)...);
  }

  template <typename... Args>
    requires (__cppsh_is_member_fn<F> &&
              __cppsh_is_data_member_eval<F, Args...>)
  constexpr decltype(auto) operator()(Args &&...args) const {
    return fn(static_cast<Args &&>(args)...);
  }

  template <typename... Args>
    requires (__cppsh_is_member_fn<F> &&
              !__cppsh_is_data_member_eval<F, Args...>)
  constexpr auto operator()(Args &&...args) const {
    auto call_l = [f = fn, ...a = std::decay_t<Args>(static_cast<Args &&>(args))](
                      auto &&...xs) -> decltype(auto) {
      return f.bind_obj(static_cast<decltype(xs) &&>(xs)...)(
          __cppsh_eval_arg(a, static_cast<decltype(xs) &&>(xs)...)...);
    };
    using CallFnT = __cppsh_call_fn<F, decltype(call_l)>;
    return cppsh_proj<CallFnT>{CallFnT{fn, call_l}};
  }

  template <char... Cs>
  constexpr auto operator_unresolved() const {
    using NextT = __cppsh_member_fn<F, Cs...>;
    return cppsh_proj<NextT>{NextT{fn}};
  }

  template <unsigned long long FnId, typename... Args>
  static constexpr auto operator_apply(Args &&...args) {
    constexpr meta::info Fn{FnId, 4};
    auto next = [...a = std::decay_t<Args>(static_cast<Args &&>(args))](
                    auto &&...xs)
        -> decltype([:Fn:](
            __cppsh_eval_arg(a, static_cast<decltype(xs) &&>(xs)...)...)) {
      return [:Fn:](
          __cppsh_eval_arg(a, static_cast<decltype(xs) &&>(xs)...)...);
    };
    return cppsh_proj<decltype(next)>{next};
  }

  constexpr auto operator!() const {
    auto p = [f = fn](auto &&...xs)
        -> decltype(!f(static_cast<decltype(xs) &&>(xs)...)) {
      return !f(static_cast<decltype(xs) &&>(xs)...);
    };
    return cppsh_proj<decltype(p)>{p};
  }
  constexpr auto operator-() const {
    auto p = [f = fn](auto &&...xs)
        -> decltype(-f(static_cast<decltype(xs) &&>(xs)...)) {
      return -f(static_cast<decltype(xs) &&>(xs)...);
    };
    return cppsh_proj<decltype(p)>{p};
  }
#define _LIBCPP_CPPSH_BINOP(OP)                                                \
  template <typename R>                                                        \
  constexpr auto operator OP(R rhs) const {                                    \
    auto p = [f = fn, r = rhs](auto &&...xs)                                   \
        -> decltype(f(static_cast<decltype(xs) &&>(xs)...)                     \
                        OP __cppsh_eval_arg(                                   \
                            r, static_cast<decltype(xs) &&>(xs)...)) {         \
      return f(static_cast<decltype(xs) &&>(xs)...)                            \
          OP __cppsh_eval_arg(r, static_cast<decltype(xs) &&>(xs)...);         \
    };                                                                         \
    return cppsh_proj<decltype(p)>{p};                                         \
  }                                                                            \
  template <typename L>                                                        \
    requires (!__cppsh_is_proj<std::remove_cvref_t<L>>)                        \
  friend constexpr auto operator OP(L lhs, const cppsh_proj &rhs) {            \
    auto p = [l = lhs, rf = rhs.fn](auto &&...xs)                              \
        -> decltype(l OP rf(static_cast<decltype(xs) &&>(xs)...)) {            \
      return l OP rf(static_cast<decltype(xs) &&>(xs)...);                     \
    };                                                                         \
    return cppsh_proj<decltype(p)>{p};                                         \
  }
  _LIBCPP_CPPSH_BINOP(==)
  _LIBCPP_CPPSH_BINOP(!=)
  _LIBCPP_CPPSH_BINOP(<)
  _LIBCPP_CPPSH_BINOP(>)
  _LIBCPP_CPPSH_BINOP(<=)
  _LIBCPP_CPPSH_BINOP(>=)
  _LIBCPP_CPPSH_BINOP(+)
  _LIBCPP_CPPSH_BINOP(-)
  _LIBCPP_CPPSH_BINOP(*)
  _LIBCPP_CPPSH_BINOP(/)
  _LIBCPP_CPPSH_BINOP(%)
  _LIBCPP_CPPSH_BINOP(&&)
  _LIBCPP_CPPSH_BINOP(||)
#undef _LIBCPP_CPPSH_BINOP
};

struct cppsh_placeholder_root {
  template <typename T>
  constexpr T &&operator()(T &&x) const noexcept {
    return static_cast<T &&>(x);
  }
};

template <unsigned int I>
struct cppsh_arg_n {
  template <typename T0, typename... Ts>
    requires (1 + sizeof...(Ts) >= I)
  static constexpr decltype(auto) pick(T0 &&x0, Ts &&...xs) noexcept {
    if constexpr (I == 1)
      return static_cast<T0 &&>(x0);
    else
      return cppsh_arg_n<I - 1>::pick(static_cast<Ts &&>(xs)...);
  }
  template <typename... Xs>
    requires (sizeof...(Xs) >= I)
  constexpr decltype(auto) operator()(Xs &&...xs) const noexcept {
    return pick(static_cast<Xs &&>(xs)...);
  }
};

